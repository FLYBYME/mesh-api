{
    "name": "@flybyme/mesh-api",
    "version": "0.2.0",
    "description": "The api ServiceModule: turns exposed mesh contracts into REST, SSE and WebSockets.",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "mesh-api-generate-client": "./dist/generate/cli.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.check.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "example:blog": "tsc -p tsconfig.example.json && node example/dist/example/blog.js",
        "example:client": "tsc -p tsconfig.example.json && node example/dist/example/generate.js"
    },
    "dependencies": {
        "@flybyme/mesh": "github:FLYBYME/mesh#v2.1.0",
        "express": "^4.22.2",
        "zod": "^3.25.76",
        "zod-to-json-schema": "^3.24.6"
    },
    "devDependencies": {
        "@types/express": "^4.17.25",
        "@types/node": "^22.0.0",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.2.2",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    },
    "license": "UNLICENSED"
}
